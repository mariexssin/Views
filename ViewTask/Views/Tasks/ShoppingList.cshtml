@model Dictionary<string, int>
@{
    ViewData["Title"] = "Shopping List";
}

<h1>Our shopping list</h1>

<table class="table table-bordered w-25 mt-3">
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Key</td>
                <td>@item.Value</td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("TimeToBuy")