@using ViewTask.Models
@{
    ViewData["Title"] = "Product Info";

    var products = new List<Product>
    {
        new Product("Bread", 10),
        new Product("Milk", 11),
        new Product("Cheese", 140),
        new Product("Sausage", 110),
        new Product("Potato", 7),
        new Product("Banana", 23),
        new Product("Tomato", 25),
        new Product("Candy", 75)
    };
}

<h1>Information about product</h1>

<table class="table table-borderless w-25 mt-3">
    <thead>
        <tr>
            <th class="fw-bold">Name</th>
            <th class="fw-bold">Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in products)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
            </tr>
        }
    </tbody>
</table>